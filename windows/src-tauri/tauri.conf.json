{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Fabrica",
  "version": "2.0.0",
  "identifier": "com.fabrica.discord",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Discord Fabrica",
        "width": 440,
        "height": 600,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https://tauri.localhost; connect-src 'self' http://127.0.0.1:6473 http://localhost:6473 https:; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
